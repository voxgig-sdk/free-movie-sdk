# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the movie/series"
      t: "`$STRING`"
    }
    poster: {
      h: "Poster"
      n: "poster"
      r: false
      sh: "URL to the poster image"
      t: "`$STRING`"
    }
    rating: {
      fo: "float"
      h: "Rating"
      n: "rating"
      r: false
      sh: "IMDb rating"
      t: "`$NUMBER`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "Title of the movie or series"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "Type of content"
      t: "`$STRING`"
    }
    year: {
      h: "Year"
      n: "year"
      r: false
      sh: "Release year"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "search"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /search"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "The Matrix"
                k: "query"
                n: "q"
                or: "q"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/search"
          q: {
            exist: [
              "limit"
              "page"
              "q"
            ]
          }
          s: [
            {
              lit: "search"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
